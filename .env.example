# Copy to .env and fill in real values. Compose reads .env automatically.
# Migrated from the live host /srv/apps/screenuploader/.env on
# root@screenuploader.bakatrouble.me (secrets redacted).

# --- Django ---
DJANGO_DEBUG=False
# Caddy terminates TLS and sets X-Forwarded-Proto: https, so keep this True
# in production. Set False only for plain-HTTP local dev.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_ALLOWED_HOSTS=screenuploader.bakatrouble.me,localhost
SECRET_KEY=change-me-to-a-long-random-string
SENTRY_DSN=

# --- Storage ---
# True = S3 (production behaviour, same as before). False = local MEDIA_ROOT.
DJANGO_USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=screenuploader
AWS_S3_REGION_NAME=eu-west-3

# --- Database / cache (compose service names) ---
# DATABASE_URL is set in docker-compose.yml from POSTGRES_* below; override here if needed.
# DATABASE_URL=postgres://screenuploader:screenuploader@db:5432/screenuploader
# REDIS_URL is set in docker-compose.yml; override here if needed.
# REDIS_URL=redis://redis:6379/1
POSTGRES_USER=screenuploader
POSTGRES_PASSWORD=change-me
POSTGRES_DB=screenuploader

# --- Site / TLS (Caddy terminates HTTPS directly, HTTP/TLS-ALPN challenge) ---
SITE_ADDRESS=screenuploader.bakatrouble.me

# --- Upload backends ---
DISCORD_BOT_TOKEN=
