{$SITE_ADDRESS:screenuploader.bakatrouble.me} {
	encode gzip zstd

	request_body {
		max_size 50MB
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	log {
		output stdout
	}
}
